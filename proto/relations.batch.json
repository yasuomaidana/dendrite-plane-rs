{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yasuomaidana/dendrite-plane-rs/proto/relations.batch.json",
  "title": "relations.batch",
  "description": "Fetches relations for a batch of issues. Error kinds: config, unauthorized, http, not_found, invalid, transport, decode.",
  "params": {
    "type": "object",
    "required": [
      "issue_ids"
    ],
    "properties": {
      "base_url": {
        "type": "string",
        "description": "Plane API base URL (optional, falls back to PLANE_BASE_URL)"
      },
      "workspace": {
        "type": "string",
        "description": "Plane workspace slug (optional, falls back to PLANE_WORKSPACE_SLUG)"
      },
      "project_id": {
        "type": "string",
        "description": "Plane project ID (optional, falls back to PLANE_PROJECT_ID)"
      },
      "issue_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "List of issue UUIDs to fetch relations for"
      },
      "fresh": {
        "type": "boolean",
        "default": false,
        "description": "Bypass the relations cache"
      }
    }
  },
  "result": {
    "type": "object",
    "required": [
      "relations",
      "errors",
      "cached",
      "fetched"
    ],
    "properties": {
      "relations": {
        "type": "object",
        "description": "Relations for requested issues, keyed by issue UUID",
        "additionalProperties": {
          "$ref": "#/$defs/relations"
        }
      },
      "errors": {
        "type": "integer",
        "minimum": 0,
        "description": "Number of issue relations that failed to fetch"
      },
      "cached": {
        "type": "integer",
        "minimum": 0,
        "description": "Number of relation sets served from cache"
      },
      "fetched": {
        "type": "integer",
        "minimum": 0,
        "description": "Number of relation sets fetched from Plane"
      }
    }
  },
  "$defs": {
    "relations": {
      "type": "object",
      "required": [
        "blocking",
        "blocked_by",
        "duplicate",
        "relates_to"
      ],
      "properties": {
        "blocking": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation_ref"
          }
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation_ref"
          }
        },
        "duplicate": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation_ref"
          }
        },
        "relates_to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation_ref"
          }
        }
      }
    },
    "relation_ref": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "error_kind": {
      "type": "string",
      "enum": [
        "config",
        "unauthorized",
        "http",
        "not_found",
        "invalid",
        "transport",
        "decode"
      ]
    }
  }
}
